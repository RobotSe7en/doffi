{
  "name": "doffi-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.28.2 <11"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter './packages/*' --filter @doffi/playground run dev",
    "build:packages": "tsc --build tsconfig.json && node scripts/generate-schemas.mjs && node scripts/build-render-browser.mjs",
    "build": "pnpm build:packages && pnpm --filter @doffi/playground build",
    "typecheck": "pnpm build:packages && tsc --project apps/playground/tsconfig.json && tsc --project tsconfig.tools.json",
    "probe:workbook-model": "pnpm build:packages && node scripts/workbook-model-baseline.mjs",
    "probe:workbook-storage": "pnpm build:packages && node scripts/workbook-baseline.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "pnpm build:packages && vitest",
    "browser:install": "node scripts/playwright.mjs install chromium --only-shell",
    "test:browser": "pnpm build && node scripts/playwright.mjs test",
    "pack:packages": "pnpm build:packages && node scripts/pack.mjs",
    "check": "pnpm check:boundaries && pnpm build:packages && tsc --project apps/playground/tsconfig.json && tsc --project tsconfig.tools.json && vitest run && pnpm --filter @doffi/playground build",
    "fixtures:docx": "python3 scripts/generate-docx-fixtures.py",
    "fixtures:pptx": "python3 scripts/generate-pptx-fixtures.py",
    "fixtures:xlsx": "python3 scripts/generate-xlsx-fixtures.py",
    "check:xlsx-fixtures": "python3 scripts/check-xlsx-fixtures.py",
    "check:xlsx-reference": "python3 scripts/xlsx-reference.py",
    "record:xlsx-reference": "python3 scripts/xlsx-reference.py --record",
    "check:pptx-fixtures": "python3 scripts/check-pptx-fixtures.py",
    "check:pptx-reference": "python3 scripts/pptx-reference.py",
    "record:pptx-reference": "python3 scripts/pptx-reference.py --record",
    "check:docx-reference": "python3 scripts/docx-reference.py",
    "record:docx-reference": "python3 scripts/docx-reference.py --record",
    "check:docx-export": "pnpm build:packages && node scripts/docx-export-acceptance.mjs",
    "check:word-closure": "pnpm build:packages && node scripts/word-closure-acceptance.mjs",
    "check:pptx-export": "pnpm build:packages && node scripts/pptx-export-acceptance.mjs",
    "check:presentation-closure": "pnpm build:packages && node scripts/presentation-closure-acceptance.mjs",
    "check:docx-export:built": "node scripts/docx-export-acceptance.mjs",
    "check:word-closure:built": "node scripts/word-closure-acceptance.mjs",
    "check:pptx-export:built": "node scripts/pptx-export-acceptance.mjs",
    "check:presentation-closure:built": "node scripts/presentation-closure-acceptance.mjs",
    "ci:office": "node scripts/ci-office.mjs",
    "check:workbook-scale": "node scripts/workbook-scale-acceptance.mjs",
    "check:workbook-performance": "node scripts/workbook-performance-acceptance.mjs",
    "check:workbook-calculation": "python3 scripts/check-workbook-calculation.py --verify-native",
    "check:workbook-editing-combinations": "node scripts/workbook-native.mjs scripts/check-workbook-editing-combinations.py --verify-native",
    "check:workbook-function-boundaries": "/usr/bin/python3 scripts/check-workbook-function-boundaries.py --verify-native",
    "check:workbook-filter-calculation": "python3 scripts/check-workbook-filter-calculation.py --verify-native",
    "check:workbook-filter-display": "node scripts/workbook-native.mjs scripts/check-workbook-filter-display.py --verify-native",
    "check:workbook-filter-headers": "node scripts/workbook-native.mjs scripts/check-workbook-filter-headers.py --verify-native",
    "check:workbook-axis": "node scripts/workbook-native.mjs scripts/check-workbook-axis.py --verify-native",
    "check:workbook-axis-names": "node scripts/workbook-native.mjs scripts/check-workbook-axis-names.py --verify-native",
    "check:workbook-axis-tables": "node scripts/workbook-native.mjs scripts/check-workbook-axis-tables.py --verify-native",
    "check:workbook-table-style-source": "python3 scripts/generate-workbook-table-style-fixture.py --check",
    "check:workbook-table-style-native": "node scripts/workbook-native.mjs scripts/check-workbook-table-style.py --verify-native",
    "check:workbook-axis-drawings": "node scripts/workbook-native.mjs scripts/check-workbook-axis-drawings.py --verify-native",
    "check:workbook-sort": "node scripts/workbook-native.mjs scripts/check-workbook-sort.py --verify-native",
    "check:workbook-merged-sort": "node scripts/workbook-native.mjs scripts/check-workbook-merged-sort.py --verify-native",
    "check:workbook-copy-merges": "node scripts/workbook-native.mjs scripts/check-workbook-copy-merges.py --verify-native",
    "check:workbook-merged-special": "node scripts/workbook-native.mjs scripts/check-workbook-merged-special.py --verify-native",
    "check:workbook-copy-comments": "node scripts/workbook-native.mjs scripts/check-workbook-copy-comments.py --verify-native",
    "check:workbook-html-clipboard": "node scripts/workbook-native.mjs scripts/check-workbook-html-clipboard.py --verify-native",
    "check:workbook-system-clipboard": "node scripts/workbook-native.mjs scripts/check-workbook-system-clipboard.py --verify-native",
    "check:workbook-copy-hyperlinks": "node scripts/workbook-native.mjs scripts/check-workbook-copy-hyperlinks.py --verify-native",
    "check:workbook-copy-rules": "node scripts/workbook-native.mjs scripts/check-workbook-copy-rules.py --verify-native",
    "check:workbook-move-definitions": "node scripts/workbook-native.mjs scripts/check-workbook-move-definitions.py --verify-native",
    "check:workbook-partial-table-move": "node scripts/workbook-native.mjs scripts/check-workbook-partial-table-move.py --verify-native",
    "check:workbook-structured-fill": "node scripts/workbook-native.mjs scripts/check-workbook-structured-fill.py --verify-native",
    "check:workbook-copy-tables": "node scripts/workbook-native.mjs scripts/check-workbook-copy-tables.py --verify-native",
    "check:workbook-note-transport": "node scripts/workbook-native.mjs scripts/check-workbook-note-transport.py --verify-native",
    "check:workbook-drawing-transport": "node scripts/workbook-native.mjs scripts/check-workbook-drawing-transport.py --verify-native",
    "check:workbook-copy-objects": "node scripts/workbook-native.mjs scripts/check-workbook-copy-objects.py --verify-native",
    "check:workbook-name-prefix": "node scripts/workbook-native.mjs scripts/check-workbook-name-prefix.py --verify-native",
    "check:workbook-copy-sheet": "node scripts/workbook-native.mjs scripts/check-workbook-copy-sheet.py --verify-native",
    "typecheck:built": "tsc --project apps/playground/tsconfig.json && tsc --project tsconfig.tools.json",
    "test:built": "vitest run"
  },
  "devDependencies": {
    "@doffi/core": "workspace:*",
    "@doffi/editor": "workspace:*",
    "@doffi/office": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@doffi/render": "workspace:*",
    "@doffi/node": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobotSe7en/doffi.git"
  }
}
